{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
